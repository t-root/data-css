{
  "name": "data-css-react",
  "version": "1.3.0",
  "description": "React integration for the configurable data-css styling DSL.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./copy-assets": "./copy-assets.cjs",
    "./build": "./build.cjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "internal",
    "react.js",
    "react.d.ts",
    "copy-assets.cjs",
    "build.cjs",
    "assets"
  ],
  "bin": {
    "data-css-react-build": "./build.cjs"
  },
  "author": "T-Hacking",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
